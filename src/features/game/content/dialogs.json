    "uncountable": {
      "seller": "How ___ {item} do you want?",
      "options": [
        "much",
        "many"
      ],
      "correct": "much",
      "hint": "{item} não dá para contar um por um, então usamos much."
    }
  },
  "quantityPlayer": "I would like ___ {item}.",
